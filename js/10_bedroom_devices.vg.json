{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "% of children with each type of screen device in their bedroom, 2023",
    "fontSize": 14,
    "fontWeight": "normal",
    "color": "#94a0ab",
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "lineHeight": 18
  },
  "width": 460,
  "height": 300,
  "data": {
    "url": "data/nnpas_bedroom_devices.csv",
    "format": {
      "type": "csv",
      "parse": {
        "age_order": "number",
        "device_order": "number",
        "pct": "number",
        "moe": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.pct * 16",
      "as": "area"
    },
    {
      "calculate": "datum.device == 'Any screen device'",
      "as": "is_total"
    },
    {
      "calculate": "format(datum.pct, datum.pct < 10 ? '.1f' : '.0f') + '%'",
      "as": "label"
    },
    {
      "calculate": "isValid(datum.moe) ? '± ' + format(datum.moe, '.1f') + ' points' : 'range not published'",
      "as": "moe_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "device",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "device_order"
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelColor": "#efe6d6",
        "labelFontSize": 12,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "t": "separator above the total row"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#94a0ab",
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "y": {
          "value": 250.0
        },
        "x": {
          "value": 0
        },
        "x2": {
          "value": 380
        }
      }
    },
    {
      "transform": [
        {
          "filter": "!datum.is_total"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "color": "#e3652a",
        "opacity": 1,
        "strokeWidth": 0
      },
      "encoding": {
        "x": {
          "field": "age_order",
          "type": "quantitative",
          "title": "Age (years)",
          "scale": {
            "domain": [
              -0.5,
              7.2
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              1,
              2,
              3,
              4
            ],
            "labelExpr": "['2–5', '5–8', '9–11', '12–14', '15–17'][datum.value]",
            "grid": false,
            "orient": "top",
            "domain": false,
            "ticks": false,
            "labelFontWeight": "bold",
            "labelColor": "#efe6d6",
            "labelFontSize": 12,
            "titleAnchor": "start",
            "titleX": 0
          }
        },
        "size": {
          "field": "area",
          "type": "quantitative",
          "scale": null
        },
        "tooltip": [
          {
            "field": "device",
            "title": "Device in bedroom"
          },
          {
            "field": "age_group",
            "title": "Age"
          },
          {
            "field": "pct",
            "title": "% of children",
            "format": ".1f"
          },
          {
            "field": "moe_label",
            "title": "Likely range (±)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_total"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": false,
        "color": "#e3652a",
        "opacity": 1,
        "strokeWidth": 1.6
      },
      "encoding": {
        "x": {
          "field": "age_order",
          "type": "quantitative",
          "title": "Age (years)",
          "scale": {
            "domain": [
              -0.5,
              7.2
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              1,
              2,
              3,
              4
            ],
            "labelExpr": "['2–5', '5–8', '9–11', '12–14', '15–17'][datum.value]",
            "grid": false,
            "orient": "top",
            "domain": false,
            "ticks": false,
            "labelFontWeight": "bold",
            "labelColor": "#efe6d6",
            "labelFontSize": 12,
            "titleAnchor": "start",
            "titleX": 0
          }
        },
        "size": {
          "field": "area",
          "type": "quantitative",
          "scale": null
        },
        "tooltip": [
          {
            "field": "device",
            "title": "Device in bedroom"
          },
          {
            "field": "age_group",
            "title": "Age"
          },
          {
            "field": "pct",
            "title": "% of children",
            "format": ".1f"
          },
          {
            "field": "moe_label",
            "title": "Likely range (±)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.pct >= 40 && !datum.is_total"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "age_order",
          "type": "quantitative",
          "title": "Age (years)",
          "scale": {
            "domain": [
              -0.5,
              7.2
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              1,
              2,
              3,
              4
            ],
            "labelExpr": "['2–5', '5–8', '9–11', '12–14', '15–17'][datum.value]",
            "grid": false,
            "orient": "top",
            "domain": false,
            "ticks": false,
            "labelFontWeight": "bold",
            "labelColor": "#efe6d6",
            "labelFontSize": 12,
            "titleAnchor": "start",
            "titleX": 0
          }
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.pct >= 40 && datum.is_total"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#ff9b63"
      },
      "encoding": {
        "x": {
          "field": "age_order",
          "type": "quantitative",
          "title": "Age (years)",
          "scale": {
            "domain": [
              -0.5,
              7.2
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              1,
              2,
              3,
              4
            ],
            "labelExpr": "['2–5', '5–8', '9–11', '12–14', '15–17'][datum.value]",
            "grid": false,
            "orient": "top",
            "domain": false,
            "ticks": false,
            "labelFontWeight": "bold",
            "labelColor": "#efe6d6",
            "labelFontSize": 12,
            "titleAnchor": "start",
            "titleX": 0
          }
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.pct < 40"
        },
        {
          "calculate": "datum.age_order + (sqrt(datum.pct * 16) / 2 + 3) / 59.74",
          "as": "lx"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "color": "#b3bcc5"
      },
      "encoding": {
        "x": {
          "field": "lx",
          "type": "quantitative",
          "title": "Age (years)",
          "scale": {
            "domain": [
              -0.5,
              7.2
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              1,
              2,
              3,
              4
            ],
            "labelExpr": "['2–5', '5–8', '9–11', '12–14', '15–17'][datum.value]",
            "grid": false,
            "orient": "top",
            "domain": false,
            "ticks": false,
            "labelFontWeight": "bold",
            "labelColor": "#efe6d6",
            "labelFontSize": 12,
            "titleAnchor": "start",
            "titleX": 0
          }
        },
        "text": {
          "field": "label"
        },
        "tooltip": [
          {
            "field": "device",
            "title": "Device in bedroom"
          },
          {
            "field": "age_group",
            "title": "Age"
          },
          {
            "field": "pct",
            "title": "% of children",
            "format": ".1f"
          },
          {
            "field": "moe_label",
            "title": "Likely range (±)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.device == 'Smartphone/watch' && datum.age_order == 4"
        },
        {
          "calculate": "[format(datum.pct, '.0f') + '% of ' + datum.age_group + ' year olds', 'have a phone in their bedroom']",
          "as": "t"
        },
        {
          "calculate": "datum.age_order + (sqrt(datum.pct * 16) / 2 + 8) / 59.74",
          "as": "lx"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#ff9b63",
        "lineHeight": 13,
        "dy": 0
      },
      "encoding": {
        "x": {
          "field": "lx",
          "type": "quantitative",
          "title": "Age (years)",
          "scale": {
            "domain": [
              -0.5,
              7.2
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              1,
              2,
              3,
              4
            ],
            "labelExpr": "['2–5', '5–8', '9–11', '12–14', '15–17'][datum.value]",
            "grid": false,
            "orient": "top",
            "domain": false,
            "ticks": false,
            "labelFontWeight": "bold",
            "labelColor": "#efe6d6",
            "labelFontSize": 12,
            "titleAnchor": "start",
            "titleX": 0
          }
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_total && datum.age_order == 4"
        },
        {
          "calculate": "['Almost all (' + format(datum.pct, '.0f') + '%) have at least', 'one screen in their bedroom']",
          "as": "t"
        },
        {
          "calculate": "datum.age_order + (sqrt(datum.pct * 16) / 2 + 8) / 59.74",
          "as": "lx"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#ff9b63",
        "lineHeight": 13,
        "dy": 0
      },
      "encoding": {
        "x": {
          "field": "lx",
          "type": "quantitative",
          "title": "Age (years)",
          "scale": {
            "domain": [
              -0.5,
              7.2
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              1,
              2,
              3,
              4
            ],
            "labelExpr": "['2–5', '5–8', '9–11', '12–14', '15–17'][datum.value]",
            "grid": false,
            "orient": "top",
            "domain": false,
            "ticks": false,
            "labelFontWeight": "bold",
            "labelColor": "#efe6d6",
            "labelFontSize": 12,
            "titleAnchor": "start",
            "titleX": 0
          }
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#b3bcc5",
      "titleColor": "#b3bcc5",
      "gridColor": "#243343",
      "domainColor": "#4b5a69",
      "tickColor": "#4b5a69",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "labelFontWeight": 500
    },
    "legend": {
      "labelColor": "#b3bcc5",
      "titleColor": "#efe6d6",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "bold",
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleLimit": 0
    },
    "title": {
      "anchor": "start",
      "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "fontSize": 16,
      "fontWeight": "bold",
      "color": "#efe6d6",
      "subtitleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "subtitleColor": "#b3bcc5",
      "subtitleFontSize": 12,
      "subtitlePadding": 4,
      "offset": 12
    },
    "header": {
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif"
    },
    "text": {
      "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "fontWeight": 500
    }
  }
}
