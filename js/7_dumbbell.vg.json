{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "% on track in all five areas: most vs least disadvantaged fifth of areas, 2009 and 2024 · states sorted by 2024 gap · ACT faded (very small numbers)",
    "fontSize": 16,
    "fontWeight": 500,
    "color": "#2f3945",
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "lineHeight": 20
  },
  "width": "container",
  "height": 470,
  "params": [
    {
      "name": "show",
      "value": "2024 vs 2009",
      "bind": {
        "input": "radio",
        "options": [
          "2024 vs 2009",
          "2024 only",
          "2009 only"
        ],
        "name": "Show"
      }
    }
  ],
  "data": {
    "url": "data/aedc_seifa.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "on_track_pct": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year == 2009 || datum.year == 2024"
    },
    {
      "calculate": "datum.group == 'Most disadvantaged' ? datum.on_track_pct : null",
      "as": "q1v"
    },
    {
      "calculate": "datum.group == 'Least disadvantaged' ? datum.on_track_pct : null",
      "as": "q5v"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "q1v",
          "as": "q1"
        },
        {
          "op": "max",
          "field": "q5v",
          "as": "q5"
        }
      ],
      "groupby": [
        "area",
        "year"
      ]
    },
    {
      "calculate": "datum.q5 - datum.q1",
      "as": "gap"
    },
    {
      "calculate": "datum.year == 2024 ? datum.gap : null",
      "as": "g24"
    },
    {
      "calculate": "datum.year == 2009 ? datum.gap : null",
      "as": "g09"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "g24",
          "as": "gap24"
        },
        {
          "op": "max",
          "field": "g09",
          "as": "gap09"
        }
      ],
      "groupby": [
        "area"
      ]
    },
    {
      "calculate": "datum.area == 'Australia' ? 1000 : datum.gap24",
      "as": "sortkey"
    },
    {
      "calculate": "datum.area == 'ACT' ? \"Very few children in ACT's most disadvantaged areas: treat with caution\" : ''",
      "as": "note"
    },
    {
      "filter": "show == '2024 vs 2009' || (show == '2024 only' ? datum.year == 2024 : datum.year == 2009)"
    },
    {
      "calculate": "show != '2024 vs 2009' ? 'm' : datum.year == 2009 ? 'a' : 'b'",
      "as": "lane"
    },
    {
      "calculate": "datum.year == 2009 && show == '2024 vs 2009'",
      "as": "hollow"
    },
    {
      "calculate": "(datum.hollow ? 0.7 : 1) * (datum.area == 'ACT' ? 0.5 : 1)",
      "as": "alpha"
    }
  ],
  "encoding": {
    "y": {
      "field": "area",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "sortkey",
        "op": "max",
        "order": "descending"
      },
      "scale": {
        "paddingInner": 0.18
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 12,
        "labelColor": "#1c2430",
        "labelFontWeight": {
          "expr": "datum.value == 'Australia' ? 'bold' : 'normal'"
        }
      }
    },
    "yOffset": {
      "field": "lane",
      "type": "nominal",
      "scale": {
        "domain": [
          "a",
          "m",
          "b"
        ]
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.group == 'Most disadvantaged' && !datum.hollow"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#8a949b",
        "strokeWidth": 3.5
      },
      "encoding": {
        "x": {
          "field": "q1",
          "type": "quantitative",
          "title": "% on track in all five areas",
          "scale": {
            "domain": [
              10,
              80
            ]
          },
          "axis": {
            "values": [
              10,
              20,
              30,
              40,
              50,
              60,
              70
            ]
          }
        },
        "x2": {
          "field": "q5"
        },
        "opacity": {
          "field": "alpha",
          "type": "quantitative",
          "scale": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.group == 'Most disadvantaged' && datum.hollow"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#5b6570",
        "strokeWidth": 1.5,
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "q1",
          "type": "quantitative",
          "title": "% on track in all five areas",
          "scale": {
            "domain": [
              10,
              80
            ]
          },
          "axis": {
            "values": [
              10,
              20,
              30,
              40,
              50,
              60,
              70
            ]
          }
        },
        "x2": {
          "field": "q5"
        },
        "opacity": {
          "field": "alpha",
          "type": "quantitative",
          "scale": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.hollow"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": false,
        "size": 90,
        "strokeWidth": 2,
        "fill": "#ffffff",
        "fillOpacity": 1
      },
      "encoding": {
        "x": {
          "field": "on_track_pct",
          "type": "quantitative",
          "title": "% on track in all five areas",
          "scale": {
            "domain": [
              10,
              80
            ]
          },
          "axis": {
            "values": [
              10,
              20,
              30,
              40,
              50,
              60,
              70
            ]
          }
        },
        "color": {
          "condition": {
            "test": "datum.area == 'ACT'",
            "value": "#5b6570"
          },
          "field": "group",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Most disadvantaged",
              "Least disadvantaged"
            ],
            "range": [
              "#d0571b",
              "#0a74c4"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "circle",
            "labelExpr": "datum.label + ' fifth of areas'",
            "labelLimit": 0
          }
        },
        "opacity": {
          "field": "alpha",
          "type": "quantitative",
          "scale": null
        },
        "tooltip": [
          {
            "field": "area",
            "title": "Area"
          },
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "on_track_pct",
            "title": "% on track",
            "format": ".1f"
          },
          {
            "field": "gap",
            "title": "Gap (points)",
            "format": ".1f"
          },
          {
            "field": "note",
            "title": "Note"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "!datum.hollow"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 130,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "on_track_pct",
          "type": "quantitative",
          "title": "% on track in all five areas",
          "scale": {
            "domain": [
              10,
              80
            ]
          },
          "axis": {
            "values": [
              10,
              20,
              30,
              40,
              50,
              60,
              70
            ]
          }
        },
        "color": {
          "condition": {
            "test": "datum.area == 'ACT'",
            "value": "#5b6570"
          },
          "field": "group",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Most disadvantaged",
              "Least disadvantaged"
            ],
            "range": [
              "#d0571b",
              "#0a74c4"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "circle",
            "labelExpr": "datum.label + ' fifth of areas'",
            "labelLimit": 0
          }
        },
        "opacity": {
          "field": "alpha",
          "type": "quantitative",
          "scale": null
        },
        "tooltip": [
          {
            "field": "area",
            "title": "Area"
          },
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "on_track_pct",
            "title": "% on track",
            "format": ".1f"
          },
          {
            "field": "gap",
            "title": "Gap (points)",
            "format": ".1f"
          },
          {
            "field": "note",
            "title": "Note"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.group == 'Most disadvantaged'"
        },
        {
          "calculate": "(show == '2024 vs 2009' ? datum.year + ': ' : '') + format(datum.gap, '.1f') + ' points'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12
      },
      "encoding": {
        "x": {
          "datum": 68,
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        },
        "color": {
          "condition": {
            "test": "datum.hollow",
            "value": "#5b6570"
          },
          "value": "#1c2430"
        },
        "opacity": {
          "condition": {
            "test": "datum.area == 'ACT'",
            "value": 0.75
          },
          "value": 1
        }
      }
    },
    {
      "transform": [
        {
          "filter": "show == '2024 vs 2009' && datum.area == 'Australia' && datum.group == 'Most disadvantaged'"
        },
        {
          "calculate": "min(datum.q1, datum.q5)",
          "as": "lx"
        },
        {
          "calculate": "datum.year + ''",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -10,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#46525d"
      },
      "encoding": {
        "x": {
          "field": "lx",
          "type": "quantitative",
          "title": "% on track in all five areas",
          "scale": {
            "domain": [
              10,
              80
            ]
          },
          "axis": {
            "values": [
              10,
              20,
              30,
              40,
              50,
              60,
              70
            ]
          }
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.area == 'Australia' && datum.group == 'Most disadvantaged'"
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "gap24",
              "as": "gap24"
            },
            {
              "op": "max",
              "field": "gap09",
              "as": "gap09"
            },
            {
              "op": "max",
              "field": "sortkey",
              "as": "sortkey"
            }
          ],
          "groupby": [
            "area"
          ]
        },
        {
          "calculate": "'Gap widened: ' + format(datum.gap09, '.1f') + ' → ' + format(datum.gap24, '.1f') + ' points since 2009'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -3,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#1c2430"
      },
      "encoding": {
        "x": {
          "datum": 51,
          "type": "quantitative"
        },
        "y": {
          "field": "area",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "sortkey",
            "op": "max",
            "order": "descending"
          },
          "scale": {
            "paddingInner": 0.18
          },
          "axis": {
            "domain": false,
            "ticks": false,
            "labelFontSize": 12,
            "labelColor": "#1c2430",
            "labelFontWeight": {
              "expr": "datum.value == 'Australia' ? 'bold' : 'normal'"
            }
          },
          "bandPosition": 0
        },
        "yOffset": {
          "value": 0
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.area != 'Australia' && datum.area != 'ACT' && datum.group == 'Most disadvantaged' && datum.year == 2024"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "gap24",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rank == 1"
        },
        {
          "calculate": "'Largest gap: ' + format(datum.gap24, '.1f') + ' points in 2024'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#8e3410",
        "dy": {
          "expr": "show == '2024 vs 2009' ? -15 : -13"
        }
      },
      "encoding": {
        "x": {
          "field": "q1",
          "type": "quantitative",
          "title": "% on track in all five areas",
          "scale": {
            "domain": [
              10,
              80
            ]
          },
          "axis": {
            "values": [
              10,
              20,
              30,
              40,
              50,
              60,
              70
            ]
          }
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "k": 1
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#1c2430",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "value": {
            "expr": "height / 9"
          }
        },
        "yOffset": null,
        "x": {
          "value": 0
        },
        "x2": {
          "value": {
            "expr": "width"
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "k": 1
          }
        ]
      },
      "transform": [
        {
          "filter": "show == '2024 vs 2009'"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": false,
        "size": 90,
        "strokeWidth": 2,
        "color": "#46525d"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width - 236"
          }
        },
        "y": {
          "value": -16
        },
        "yOffset": null
      }
    },
    {
      "data": {
        "values": [
          {
            "k": 1
          }
        ]
      },
      "transform": [
        {
          "filter": "show == '2024 vs 2009'"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 110,
        "color": "#46525d",
        "opacity": 1
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width - 220"
          }
        },
        "y": {
          "value": -16
        },
        "yOffset": null
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "hollow = 2009, solid = 2024"
          }
        ]
      },
      "transform": [
        {
          "filter": "show == '2024 vs 2009'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "color": "#46525d"
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width - 208"
          }
        },
        "y": {
          "value": -16
        },
        "yOffset": null,
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#4a5560",
      "titleColor": "#4a5560",
      "gridColor": "#e7e9e8",
      "domainColor": "#b8bec2",
      "tickColor": "#b8bec2",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "labelFontWeight": 500
    },
    "legend": {
      "labelColor": "#4a5560",
      "titleColor": "#1c2430",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "bold",
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleLimit": 0
    },
    "title": {
      "anchor": "start",
      "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "fontSize": 16,
      "fontWeight": "bold",
      "color": "#1c2430",
      "subtitleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "subtitleColor": "#46525d",
      "subtitleFontSize": 12,
      "subtitlePadding": 4,
      "offset": 12
    },
    "header": {
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif"
    },
    "text": {
      "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "fontWeight": 500
    }
  }
}
