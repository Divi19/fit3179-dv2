{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Figure 10. How an average day is spent, by age, 2023 · hours of 24",
    "offset": 26,
    "fontSize": 16,
    "fontWeight": 500,
    "color": "#d0d6dc",
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "lineHeight": 20
  },
  "spacing": 10,
  "vconcat": [
    {
      "data": {
        "url": "data/nnpas_day.csv",
        "format": {
          "type": "csv",
          "parse": {
            "age_order": "number",
            "activity_order": "number",
            "minutes": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "100 * datum.minutes / 1440",
          "as": "pct_day"
        },
        {
          "calculate": "'Ages ' + datum.age_group",
          "as": "age_head"
        }
      ],
      "facet": {
        "column": {
          "field": "age_head",
          "type": "nominal",
          "sort": {
            "field": "age_order",
            "op": "min"
          },
          "header": {
            "labels": false,
            "title": null
          }
        }
      },
      "spacing": 20,
      "spec": {
        "width": 211,
        "height": 232,
        "layer": [
          {
            "params": [
              {
                "name": "pick",
                "select": {
                  "type": "point",
                  "fields": [
                    "activity"
                  ],
                  "toggle": "true"
                },
                "bind": "legend"
              }
            ],
            "mark": {
              "type": "arc",
              "innerRadius": 60,
              "outerRadius": 89,
              "stroke": "#1b2b3d",
              "strokeWidth": 1.5,
              "y": 106
            },
            "encoding": {
              "theta": {
                "field": "minutes",
                "type": "quantitative",
                "stack": true,
                "scale": {
                  "domain": [
                    0,
                    1440
                  ]
                }
              },
              "order": {
                "field": "activity_order"
              },
              "color": {
                "field": "activity",
                "type": "nominal",
                "title": "Click to highlight",
                "scale": {
                  "domain": [
                    "Sleep",
                    "Active",
                    "Screens",
                    "Everything else"
                  ],
                  "range": [
                    "#a9b9d6",
                    "#3f9ee8",
                    "#f08a24",
                    "#2f3e4d"
                  ]
                },
                "legend": {
                  "orient": "top",
                  "direction": "horizontal",
                  "symbolType": "square",
                  "symbolStrokeWidth": 0,
                  "title": "Click a colour to highlight it",
                  "symbolSize": 180,
                  "labelFontSize": 13,
                  "titleFontSize": 13,
                  "labelColor": "#efe6d6",
                  "columnPadding": 18
                }
              },
              "opacity": {
                "condition": {
                  "param": "pick",
                  "value": 1
                },
                "value": 0.18
              },
              "tooltip": [
                {
                  "field": "age_group",
                  "title": "Age"
                },
                {
                  "field": "activity",
                  "title": "Activity"
                },
                {
                  "field": "label",
                  "title": "Time per day"
                },
                {
                  "field": "pct_day",
                  "title": "% of the day",
                  "format": ".1f"
                },
                {
                  "field": "note",
                  "title": "Note"
                }
              ]
            }
          },
          {
            "transform": [
              {
                "filter": "datum.activity == 'Sleep'"
              },
              {
                "calculate": "[0, 6, 12, 18]",
                "as": "h"
              },
              {
                "flatten": [
                  "h"
                ]
              },
              {
                "calculate": "datum.h * 60",
                "as": "hm"
              },
              {
                "calculate": "datum.h + 'h'",
                "as": "ht"
              }
            ],
            "mark": {
              "type": "text",
              "fontSize": 12,
              "color": "#94a0ab",
              "radius": 100,
              "y": 106
            },
            "encoding": {
              "theta": {
                "field": "hm",
                "type": "quantitative",
                "stack": null,
                "scale": {
                  "domain": [
                    0,
                    1440
                  ]
                }
              },
              "text": {
                "field": "ht"
              }
            }
          },
          {
            "transform": [
              {
                "filter": "datum.activity == 'Screens'"
              }
            ],
            "mark": {
              "type": "text",
              "align": "center",
              "baseline": "bottom",
              "fontSize": 14,
              "fontWeight": "bold",
              "color": "#efe6d6",
              "x": 105.5,
              "y": 107
            },
            "encoding": {
              "text": {
                "field": "age_head"
              }
            }
          },
          {
            "transform": [
              {
                "filter": "datum.activity == 'Screens'"
              },
              {
                "calculate": "datum.label + ' screens'",
                "as": "t"
              }
            ],
            "mark": {
              "type": "text",
              "align": "center",
              "baseline": "top",
              "fontSize": 12,
              "fontWeight": "bold",
              "color": "#f08a24",
              "x": 105.5,
              "y": 110
            },
            "encoding": {
              "text": {
                "field": "t"
              }
            }
          },
          {
            "transform": [
              {
                "filter": "datum.activity == 'Active' && datum.note != ''"
              },
              {
                "calculate": "'Activity includes light play'",
                "as": "t"
              }
            ],
            "mark": {
              "type": "text",
              "align": "center",
              "baseline": "bottom",
              "fontSize": 12,
              "fontStyle": "italic",
              "color": "#3f9ee8",
              "x": 105.5,
              "y": 233
            },
            "encoding": {
              "text": {
                "field": "t"
              }
            }
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/nnpas_day.csv",
        "format": {
          "type": "csv",
          "parse": {
            "age_order": "number",
            "activity_order": "number",
            "minutes": "number"
          }
        }
      },
      "width": 1140,
      "height": 34,
      "transform": [
        {
          "filter": "datum.age_group == '5–8' || datum.age_group == '15–17'"
        },
        {
          "calculate": "datum.age_group == '5–8' ? -datum.minutes : datum.minutes",
          "as": "signed"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "signed",
              "as": "change"
            }
          ],
          "groupby": [
            "activity"
          ]
        },
        {
          "pivot": "activity",
          "value": "change"
        },
        {
          "calculate": "['Between ages 5–8 and 15–17, sleep falls ' + abs(datum.Sleep) + ' min a day and activity ' + abs(datum.Active) + ' min, while screens rise ' + datum.Screens + ' min.', 'Screens take almost exactly the time the other two lose (' + (abs(datum.Sleep) + abs(datum.Active)) + ' min).']",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#efe6d6",
        "lineHeight": 16,
        "x": 0,
        "y": 0
      },
      "encoding": {
        "text": {
          "field": "t"
        },
        "tooltip": [
          {
            "field": "Sleep",
            "title": "Change in sleep (min)"
          },
          {
            "field": "Active",
            "title": "Change in activity (min)"
          },
          {
            "field": "Screens",
            "title": "Change in screens (min)"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#b3bcc5",
      "titleColor": "#b3bcc5",
      "gridColor": "#243343",
      "domainColor": "#4b5a69",
      "tickColor": "#4b5a69",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "labelFontWeight": 500
    },
    "legend": {
      "labelColor": "#b3bcc5",
      "titleColor": "#efe6d6",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "bold",
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleLimit": 0
    },
    "title": {
      "anchor": "start",
      "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "fontSize": 16,
      "fontWeight": "bold",
      "color": "#efe6d6",
      "subtitleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "subtitleColor": "#b3bcc5",
      "subtitleFontSize": 12,
      "subtitlePadding": 4,
      "offset": 12
    },
    "header": {
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif"
    },
    "text": {
      "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "fontWeight": 500
    }
  }
}
