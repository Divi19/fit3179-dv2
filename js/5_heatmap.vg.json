{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "% of children on track on all five areas, by state · colour = change since the previous collection",
    "fontSize": 14,
    "fontWeight": "normal",
    "color": "#94a0ab",
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "lineHeight": 18
  },
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/aedc_states.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "pct": "number",
        "n": "number",
        "children": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.indicator == 'On track on all 5 domains'"
    },
    {
      "window": [
        {
          "op": "lag",
          "field": "pct",
          "as": "prev"
        }
      ],
      "sort": [
        {
          "field": "year"
        }
      ],
      "groupby": [
        "state"
      ]
    },
    {
      "calculate": "isValid(datum.prev) ? datum.pct - datum.prev : null",
      "as": "change"
    },
    {
      "calculate": "!isValid(datum.change) ? '2009: starting point' : datum.change <= -2 ? 'Down 2+ pts' : datum.change < -0.5 ? 'Down 0.5–2' : datum.change <= 0.5 ? 'Little change' : datum.change < 2 ? 'Up 0.5–2' : 'Up 2+ pts'",
      "as": "class"
    },
    {
      "calculate": "isValid(datum.change) ? (datum.change > 0 ? '+' : datum.change < 0 ? '−' : '±') + format(abs(datum.change), '.1f') + ' pts' : 'first collection'",
      "as": "change_label"
    },
    {
      "calculate": "datum.year == 2024 && datum.state != 'Australia' ? 'Change since 2021: ' + lower(datum.sig_2021_2024) : ''",
      "as": "sig_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "labelFontWeight": "bold",
        "labelPadding": 12
      }
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": [
        "Australia",
        "NSW",
        "VIC",
        "WA",
        "SA",
        "QLD",
        "TAS",
        "ACT",
        "NT"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "labelColor": "#efe6d6",
        "labelFontSize": 12,
        "labelFontWeight": {
          "expr": "datum.value == 'Australia' ? 'bold' : 'normal'"
        }
      }
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "row": "Australia"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#3a2c24",
        "cornerRadius": 4
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "-76"
          }
        },
        "x2": {
          "value": {
            "expr": "width + 5"
          }
        },
        "y": {
          "value": -2
        },
        "y2": {
          "value": {
            "expr": "height / 9 + 1"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2009"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "#4b5a69",
        "strokeWidth": 1,
        "cornerRadius": 2,
        "width": {
          "band": 0.96
        },
        "height": {
          "band": 0.9
        }
      },
      "encoding": {
        "color": {
          "field": "class",
          "type": "ordinal",
          "title": "Change since previous collection",
          "scale": {
            "domain": [
              "2009: starting point",
              "Down 2+ pts",
              "Down 0.5–2",
              "Little change",
              "Up 0.5–2",
              "Up 2+ pts"
            ],
            "range": [
              "#26333f",
              "#e3652a",
              "#f5a25e",
              "#34434f",
              "#9ccaee",
              "#3f9ee8"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolStrokeColor": {
              "expr": "datum.value == '2009: starting point' ? '#b8bec2' : '#d5d9db'"
            },
            "symbolStrokeWidth": {
              "expr": "datum.value == '2009: starting point' ? 1 : 0.5"
            }
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "pct",
            "title": "% on track on all 5",
            "format": ".1f"
          },
          {
            "field": "change_label",
            "title": "Change from previous collection"
          },
          {
            "field": "sig_label",
            "title": "Statistical significance"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year != 2009"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "#142231",
        "strokeWidth": 2,
        "cornerRadius": 2
      },
      "encoding": {
        "color": {
          "field": "class",
          "type": "ordinal",
          "title": "Change since previous collection",
          "scale": {
            "domain": [
              "2009: starting point",
              "Down 2+ pts",
              "Down 0.5–2",
              "Little change",
              "Up 0.5–2",
              "Up 2+ pts"
            ],
            "range": [
              "#26333f",
              "#e3652a",
              "#f5a25e",
              "#34434f",
              "#9ccaee",
              "#3f9ee8"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolStrokeColor": {
              "expr": "datum.value == '2009: starting point' ? '#b8bec2' : '#d5d9db'"
            },
            "symbolStrokeWidth": {
              "expr": "datum.value == '2009: starting point' ? 1 : 0.5"
            }
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "pct",
            "title": "% on track on all 5",
            "format": ".1f"
          },
          {
            "field": "change_label",
            "title": "Change from previous collection"
          },
          {
            "field": "sig_label",
            "title": "Statistical significance"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state != 'Australia'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "normal"
      },
      "encoding": {
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": [
            {
              "test": "indexof(datum.class, '0.5') >= 0",
              "value": "#1c2430"
            },
            {
              "test": "datum.year == 2009",
              "value": "#b3bcc5"
            },
            {
              "test": "datum.class == 'Down 2+ pts' || datum.class == 'Up 2+ pts'",
              "value": "#ffffff"
            }
          ],
          "value": "#efe6d6"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Australia'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": [
            {
              "test": "indexof(datum.class, '0.5') >= 0",
              "value": "#1c2430"
            },
            {
              "test": "datum.year == 2009",
              "value": "#b3bcc5"
            },
            {
              "test": "datum.class == 'Down 2+ pts' || datum.class == 'Up 2+ pts'",
              "value": "#ffffff"
            }
          ],
          "value": "#efe6d6"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "row": "Australia"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "fill": null,
        "stroke": "#efe6d6",
        "strokeWidth": 2,
        "cornerRadius": 4
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "-76"
          }
        },
        "x2": {
          "value": {
            "expr": "width + 5"
          }
        },
        "y": {
          "value": -2
        },
        "y2": {
          "value": {
            "expr": "height / 9 + 1"
          }
        }
      }
    }
  ],
  "config": {
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#b3bcc5",
      "titleColor": "#b3bcc5",
      "gridColor": "#243343",
      "domainColor": "#4b5a69",
      "tickColor": "#4b5a69",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "labelFontWeight": 500
    },
    "legend": {
      "labelColor": "#b3bcc5",
      "titleColor": "#efe6d6",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "bold",
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleLimit": 0
    },
    "title": {
      "anchor": "start",
      "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "fontSize": 16,
      "fontWeight": "bold",
      "color": "#efe6d6",
      "subtitleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "subtitleColor": "#b3bcc5",
      "subtitleFontSize": 12,
      "subtitlePadding": 4,
      "offset": 12
    },
    "header": {
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif"
    },
    "text": {
      "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "fontWeight": 500
    }
  }
}
