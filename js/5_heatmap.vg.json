{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Seven of eight states slipped in 2024",
    "subtitle": "% of children on track on all five areas, by state · colour = change since the previous collection"
  },
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/aedc_states.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "pct": "number",
        "n": "number",
        "children": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.indicator == 'On track on all 5 domains'"
    },
    {
      "window": [
        {
          "op": "lag",
          "field": "pct",
          "as": "prev"
        }
      ],
      "sort": [
        {
          "field": "year"
        }
      ],
      "groupby": [
        "state"
      ]
    },
    {
      "calculate": "isValid(datum.prev) ? datum.pct - datum.prev : null",
      "as": "change"
    },
    {
      "calculate": "!isValid(datum.change) ? '2009: starting point' : datum.change <= -2 ? 'Down 2+ pts' : datum.change < -0.5 ? 'Down 0.5–2' : datum.change <= 0.5 ? 'Little change' : datum.change < 2 ? 'Up 0.5–2' : 'Up 2+ pts'",
      "as": "class"
    },
    {
      "calculate": "isValid(datum.change) ? (datum.change > 0 ? '+' : datum.change < 0 ? '−' : '±') + format(abs(datum.change), '.1f') + ' pts' : 'first collection'",
      "as": "change_label"
    },
    {
      "calculate": "datum.year == 2024 && datum.state != 'Australia' ? 'Change since 2021: ' + lower(datum.sig_2021_2024) : ''",
      "as": "sig_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "labelFontWeight": "bold"
      }
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": [
        "Australia",
        "NSW",
        "VIC",
        "WA",
        "SA",
        "QLD",
        "TAS",
        "ACT",
        "NT"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "labelColor": "#1d2a35",
        "labelFontSize": 12,
        "labelFontWeight": {
          "expr": "datum.value == 'Australia' ? 'bold' : 'normal'"
        }
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.year == 2009"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "#b8bec2",
        "strokeWidth": 1,
        "cornerRadius": 2,
        "width": {
          "band": 0.96
        },
        "height": {
          "band": 0.9
        }
      },
      "encoding": {
        "color": {
          "field": "class",
          "type": "ordinal",
          "title": "Change since previous collection",
          "scale": {
            "domain": [
              "2009: starting point",
              "Down 2+ pts",
              "Down 0.5–2",
              "Little change",
              "Up 0.5–2",
              "Up 2+ pts"
            ],
            "range": [
              "#ffffff",
              "#b3561a",
              "#eda96a",
              "#e6e7e4",
              "#9cc9d6",
              "#007c9e"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolStrokeColor": {
              "expr": "datum.value == '2009: starting point' ? '#b8bec2' : '#d5d9db'"
            },
            "symbolStrokeWidth": {
              "expr": "datum.value == '2009: starting point' ? 1 : 0.5"
            }
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "pct",
            "title": "% on track on all 5",
            "format": ".1f"
          },
          {
            "field": "change_label",
            "title": "Change from previous collection"
          },
          {
            "field": "sig_label",
            "title": "Statistical significance"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year != 2009"
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 2,
        "cornerRadius": 2
      },
      "encoding": {
        "color": {
          "field": "class",
          "type": "ordinal",
          "title": "Change since previous collection",
          "scale": {
            "domain": [
              "2009: starting point",
              "Down 2+ pts",
              "Down 0.5–2",
              "Little change",
              "Up 0.5–2",
              "Up 2+ pts"
            ],
            "range": [
              "#ffffff",
              "#b3561a",
              "#eda96a",
              "#e6e7e4",
              "#9cc9d6",
              "#007c9e"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolStrokeColor": {
              "expr": "datum.value == '2009: starting point' ? '#b8bec2' : '#d5d9db'"
            },
            "symbolStrokeWidth": {
              "expr": "datum.value == '2009: starting point' ? 1 : 0.5"
            }
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "pct",
            "title": "% on track on all 5",
            "format": ".1f"
          },
          {
            "field": "change_label",
            "title": "Change from previous collection"
          },
          {
            "field": "sig_label",
            "title": "Statistical significance"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state != 'Australia'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "normal"
      },
      "encoding": {
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": [
            {
              "test": "datum.year == 2009",
              "value": "#5b6670"
            },
            {
              "test": "datum.class == 'Down 2+ pts' || datum.class == 'Up 2+ pts'",
              "value": "#ffffff"
            }
          ],
          "value": "#1d2a35"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Australia'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": [
            {
              "test": "datum.year == 2009",
              "value": "#5b6670"
            },
            {
              "test": "datum.class == 'Down 2+ pts' || datum.class == 'Up 2+ pts'",
              "value": "#ffffff"
            }
          ],
          "value": "#1d2a35"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "k": 1
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#1d2a35",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "x2": {
          "value": {
            "expr": "width"
          }
        },
        "y": {
          "value": {
            "expr": "height / 9"
          }
        }
      }
    }
  ],
  "config": {
    "font": "Atkinson Hyperlegible",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b6670",
      "titleColor": "#5b6670",
      "gridColor": "#e7e9e8",
      "domainColor": "#b8bec2",
      "tickColor": "#b8bec2",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "legend": {
      "labelColor": "#5b6670",
      "titleColor": "#1d2a35",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "title": {
      "anchor": "start",
      "font": "Atkinson Hyperlegible",
      "fontSize": 15,
      "fontWeight": "bold",
      "color": "#1d2a35",
      "subtitleFont": "Atkinson Hyperlegible",
      "subtitleColor": "#5b6670",
      "subtitleFontSize": 12,
      "subtitlePadding": 4,
      "offset": 12
    },
    "header": {
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "text": {
      "font": "Atkinson Hyperlegible"
    }
  }
}
