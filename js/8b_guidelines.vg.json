{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Figure 12. % of children meeting each guideline, by age, 2023 · arrow runs from ages 5–8 to 15–17",
    "fontSize": 16,
    "fontWeight": 500,
    "color": "#d0d6dc",
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "lineHeight": 20
  },
  "width": "container",
  "height": 260,
  "params": [
    {
      "name": "sex",
      "value": "All",
      "bind": {
        "input": "radio",
        "options": [
          "All",
          "Boys",
          "Girls"
        ],
        "name": "Show"
      }
    }
  ],
  "data": {
    "url": "data/nnpas_guidelines.csv",
    "format": {
      "type": "csv",
      "parse": {
        "age_order": "number",
        "guideline_order": "number",
        "pct": "number",
        "moe": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.sex == sex && datum.guideline != 'All guidelines'"
    },
    {
      "calculate": "datum.age_order == 0 ? datum.pct : null",
      "as": "p_first"
    },
    {
      "calculate": "datum.age_order == 3 ? datum.pct : null",
      "as": "p_last"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "p_first",
          "as": "start"
        },
        {
          "op": "max",
          "field": "p_last",
          "as": "teen_pct"
        }
      ],
      "groupby": [
        "guideline"
      ]
    },
    {
      "calculate": "datum.teen_pct < datum.start ? 'triangle-left' : 'triangle-right'",
      "as": "dir"
    },
    {
      "calculate": "'Ages ' + datum.age_group",
      "as": "age"
    },
    {
      "calculate": "isValid(datum.moe) ? '± ' + format(datum.moe, '.1f') : 'not published'",
      "as": "moe_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "guideline",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "teen_pct",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "labelFontSize": 12,
        "labelColor": "#efe6d6",
        "labelFontWeight": "bold",
        "domain": false,
        "ticks": false,
        "labelPadding": 10
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.age_order == 0"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#94a0ab",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "quantitative",
          "title": "% of children meeting the guideline",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "labelExpr": "datum.value + '%'"
          }
        },
        "x2": {
          "field": "teen_pct"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.age_order == 3"
        },
        {
          "calculate": "datum.teen_pct + (datum.dir == 'triangle-left' ? 1.6 : -1.6)",
          "as": "tip"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 1,
        "size": 110,
        "color": "#b3bcc5",
        "strokeWidth": 0
      },
      "encoding": {
        "x": {
          "field": "tip",
          "type": "quantitative",
          "title": "% of children meeting the guideline",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "labelExpr": "datum.value + '%'"
          }
        },
        "shape": {
          "field": "dir",
          "type": "nominal",
          "scale": {
            "domain": [
              "triangle-left",
              "triangle-right"
            ],
            "range": [
              "triangle-left",
              "triangle-right"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 1,
        "size": 170,
        "stroke": "#142231",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative",
          "title": "% of children meeting the guideline",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "labelExpr": "datum.value + '%'"
          }
        },
        "color": {
          "field": "age",
          "type": "ordinal",
          "title": "Age",
          "sort": {
            "field": "age_order"
          },
          "scale": {
            "domain": [
              "Ages 5–8",
              "Ages 9–11",
              "Ages 12–14",
              "Ages 15–17"
            ],
            "range": [
              "#3d7fbf",
              "#5aa5e6",
              "#9ccaee",
              "#e6f2fc"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolStrokeWidth": 0
          }
        },
        "tooltip": [
          {
            "field": "guideline",
            "title": "Guideline"
          },
          {
            "field": "age_group",
            "title": "Age"
          },
          {
            "field": "pct",
            "title": "% meeting",
            "format": ".1f"
          },
          {
            "field": "moe_label",
            "title": "Likely range (±)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.age_order == 3 && (datum.guideline == 'Activity' || datum.guideline == 'Screen time')"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "pct",
              "as": "worst_teen"
            },
            {
              "op": "max",
              "field": "teen_pct",
              "as": "teen_edge"
            }
          ]
        },
        {
          "filter": "datum.worst_teen < 10 && datum.guideline == 'Screen time'"
        },
        {
          "calculate": "datum.teen_edge + 2",
          "as": "lx"
        },
        {
          "calculate": "'Fewer than 1 in 10 teens meet these'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#f08a24",
        "dy": {
          "expr": "height / 8"
        }
      },
      "encoding": {
        "x": {
          "field": "lx",
          "type": "quantitative",
          "title": "% of children meeting the guideline",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "labelExpr": "datum.value + '%'"
          }
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.age_order == 3 && datum.guideline == 'Sleep'"
        },
        {
          "calculate": "datum.teen_pct - 5",
          "as": "lx"
        },
        {
          "calculate": "'Sleep mostly holds'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#3f9ee8"
      },
      "encoding": {
        "x": {
          "field": "lx",
          "type": "quantitative",
          "title": "% of children meeting the guideline",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "labelExpr": "datum.value + '%'"
          }
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#b3bcc5",
      "titleColor": "#b3bcc5",
      "gridColor": "#243343",
      "domainColor": "#4b5a69",
      "tickColor": "#4b5a69",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "labelFontWeight": 500
    },
    "legend": {
      "labelColor": "#b3bcc5",
      "titleColor": "#efe6d6",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "bold",
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleLimit": 0
    },
    "title": {
      "anchor": "start",
      "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "fontSize": 16,
      "fontWeight": "bold",
      "color": "#efe6d6",
      "subtitleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "subtitleColor": "#b3bcc5",
      "subtitleFontSize": 12,
      "subtitlePadding": 4,
      "offset": 12
    },
    "header": {
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif"
    },
    "text": {
      "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "fontWeight": 500
    }
  }
}
