{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where children start school behind",
    "subtitle": {
      "expr": "'Share of children developmentally vulnerable' + (measure == 'One or more domains' ? ' on one or more areas' : ' in ' + lower(measure)) + ', by council, 2024 · use the menu to switch areas of development'"
    }
  },
  "params": [
    {
      "name": "measure",
      "value": "One or more domains",
      "bind": {
        "input": "select",
        "options": [
          "One or more domains",
          "Physical health",
          "Social competence",
          "Emotional maturity",
          "Language & thinking",
          "Communication"
        ],
        "name": "Show: "
      }
    }
  ],
  "spacing": 24,
  "vconcat": [
    {
      "width": 1090,
      "height": 600,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -133.5,
          0
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/aus_lga.topojson",
            "format": {
              "type": "topojson",
              "feature": "lga"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#dfe2e3",
            "stroke": "#ffffff",
            "strokeWidth": 0.25
          }
        },
        {
          "data": {
            "url": "data/aedc_lga_domains.csv",
            "format": {
              "type": "csv",
              "parse": {
                "lga_code": "string",
                "children_assessed": "number",
                "vulnerable_n": "number",
                "vulnerable_pct": "number"
              }
            }
          },
          "transform": [
            {
              "filter": "datum.measure == measure && isValid(datum.vulnerable_pct)"
            },
            {
              "lookup": "lga_code",
              "from": {
                "data": {
                  "url": "data/aus_lga.topojson",
                  "format": {
                    "type": "topojson",
                    "feature": "lga"
                  }
                },
                "key": "properties.LGA_CODE24"
              },
              "as": "geo"
            },
            {
              "calculate": "datum.measure == 'One or more domains' ? (datum.vulnerable_pct < 15 ? 0 : datum.vulnerable_pct < 20 ? 1 : datum.vulnerable_pct < 25 ? 2 : datum.vulnerable_pct < 30 ? 3 : datum.vulnerable_pct < 40 ? 4 : 5) : (datum.vulnerable_pct < 6 ? 0 : datum.vulnerable_pct < 9 ? 1 : datum.vulnerable_pct < 12 ? 2 : datum.vulnerable_pct < 15 ? 3 : datum.vulnerable_pct < 20 ? 4 : 5)",
              "as": "class"
            },
            {
              "calculate": "datum.vulnerable_pct >= 90 ? '90% or more' : format(datum.vulnerable_pct, '.1f') + '%'",
              "as": "pct_label"
            }
          ],
          "params": [
            {
              "name": "hover",
              "select": {
                "type": "point",
                "on": "pointerover",
                "clear": "pointerout",
                "fields": [
                  "lga_code"
                ]
              }
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "#ffffff",
            "strokeWidth": 0.25
          },
          "encoding": {
            "shape": {
              "field": "geo",
              "type": "geojson"
            },
            "color": {
              "field": "class",
              "type": "ordinal",
              "scale": {
                "domain": [
                  0,
                  1,
                  2,
                  3,
                  4,
                  5
                ],
                "range": [
                  "#fbeedd",
                  "#f6d2a9",
                  "#eda96a",
                  "#d97d33",
                  "#b3561a",
                  "#7a3510"
                ]
              },
              "legend": {
                "title": "% of children vulnerable",
                "orient": "none",
                "legendX": 0,
                "legendY": 440,
                "type": "symbol",
                "symbolType": "square",
                "symbolSize": 180,
                "symbolStrokeWidth": 0,
                "labelExpr": "measure == 'One or more domains' ? ['Under 15%', '15–20%', '20–25%', '25–30%', '30–40%', '40% or more'][datum.value] : ['Under 6%', '6–9%', '9–12%', '12–15%', '15–20%', '20% or more'][datum.value]"
              }
            },
            "strokeWidth": {
              "condition": {
                "param": "hover",
                "empty": false,
                "value": 2
              },
              "value": 0.25
            },
            "stroke": {
              "condition": {
                "param": "hover",
                "empty": false,
                "value": "#1d2a35"
              },
              "value": "#ffffff"
            },
            "tooltip": [
              {
                "field": "lga_name",
                "title": "Council"
              },
              {
                "field": "state",
                "title": "State"
              },
              {
                "field": "measure",
                "title": "Area"
              },
              {
                "field": "pct_label",
                "title": "Vulnerable"
              },
              {
                "field": "vulnerable_n",
                "title": "Vulnerable children",
                "format": ","
              },
              {
                "field": "children_assessed",
                "title": "Children assessed",
                "format": ","
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/aus_lga.topojson",
            "format": {
              "type": "topojson",
              "feature": "states"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": null,
            "stroke": "#5b6670",
            "strokeWidth": 0.9
          }
        },
        {
          "data": {
            "values": [
              {
                "lon": 129.5,
                "lat": -11.4,
                "t": "Remote NT councils: more than half"
              },
              {
                "lon": 129.5,
                "lat": -12.4,
                "t": "of children start school vulnerable"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "right",
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#7a3510",
            "opacity": {
              "expr": "measure == 'One or more domains' ? 1 : 0"
            }
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "t": "Grey = result suppressed (too few children to report)"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "bottom",
            "fontSize": 10,
            "color": "#5b6670",
            "x": 1090,
            "y": 600
          },
          "encoding": {
            "text": {
              "field": "t"
            }
          }
        }
      ]
    },
