{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Average % of daily energy, 2023 · small bars show the likely range",
    "offset": 42,
    "fontSize": 14,
    "fontWeight": "normal",
    "color": "#94a0ab",
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "lineHeight": 18
  },
  "data": {
    "url": "data/nnpas_nutrients.csv",
    "format": {
      "type": "csv",
      "parse": {
        "age_order": "number",
        "pct_energy": "number",
        "moe": "number",
        "limit": "number",
        "ideal": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.nutrient == 'Free sugars' ? 'Under 10% (ideally under 5%), WHO' : 'No more than 10%, NHMRC'",
      "as": "limit_label"
    }
  ],
  "spacing": 78,
  "hconcat": [
    {
      "title": {
        "text": "Saturated + trans fat",
        "subtitle": "NHMRC target: no more than 10% of energy",
        "fontSize": 14,
        "subtitleFontSize": 12
      },
      "width": 410,
      "height": 210,
      "transform": [
        {
          "filter": "datum.nutrient == 'Saturated + trans fat'"
        }
      ],
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "nominal",
          "title": null,
          "sort": [
            "2–4",
