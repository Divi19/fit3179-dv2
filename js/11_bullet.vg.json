{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Teenagers tip over the sugar limit",
    "subtitle": "Average % of daily energy from free sugars, 2023 · WHO advises under 10%, ideally under 5%"
  },
  "width": "container",
  "height": 210,
  "data": {
    "url": "data/nnpas_free_sugars.csv",
    "format": {
      "type": "csv",
      "parse": {
        "free_sugars_pct": "number",
        "moe": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "age_group",
      "type": "nominal",
      "title": null,
      "sort": [
        "2–4 yrs",
        "5–11 yrs",
        "12–17 yrs",
        "Adults 18+"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontWeight": "bold",
        "labelColor": "#1d2a35",
        "labelFontSize": 12
      }
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "a": 0,
            "b": 5,
            "band": "Ideal (under 5%)"
          },
          {
            "a": 5,
            "b": 10,
            "band": "Within limit"
          },
          {
            "a": 10,
            "b": 14,
            "band": "Over limit"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "a",
          "type": "quantitative",
          "title": "% of daily energy from free sugars",
          "scale": {
            "domain": [
              0,
              14
            ]
          },
          "axis": {
            "values": [
              0,
              2,
              4,
              5,
              6,
              8,
              10,
              12,
              14
            ],
            "format": "d"
          }
        },
        "x2": {
          "field": "b"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": {
            "expr": "height"
          }
        },
        "color": {
          "field": "band",
          "type": "nominal",
          "scale": {
            "domain": [
              "Ideal (under 5%)",
              "Within limit",
              "Over limit"
            ],
            "range": [
              "#f3f5f4",
              "#e6eae8",
              "#f7e3d6"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "square"
          }
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.42
        },
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "x": {
          "field": "free_sugars_pct",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.free_sugars_pct >= 10",
            "value": "#b3561a"
          },
          "value": {
            "expr": "datum.group == 'Adults' ? '#9aa1a6' : '#007c9e'"
          }
        },
        "tooltip": [
          {
            "field": "age_group",
            "title": "Age"
          },
          {
            "field": "free_sugars_pct",
            "title": "% of energy",
            "format": ".1f"
          },
          {
            "field": "moe",
            "title": "± margin of error"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11.5,
        "fontWeight": "bold",
        "color": "#1d2a35"
      },
      "encoding": {
        "x": {
          "field": "free_sugars_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "free_sugars_pct",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 10
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5,
        "color": "#1d2a35"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": {
            "expr": "height"
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 10,
            "t": "WHO limit"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "dy": -4,
        "fontSize": 10.5,
        "fontWeight": "bold",
        "color": "#1d2a35",
        "baseline": "bottom"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "font": "Atkinson Hyperlegible",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b6670",
      "titleColor": "#5b6670",
      "gridColor": "#e7e9e8",
      "domainColor": "#b8bec2",
      "tickColor": "#b8bec2",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "legend": {
      "labelColor": "#5b6670",
      "titleColor": "#1d2a35",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "title": {
      "anchor": "start",
      "font": "Atkinson Hyperlegible",
      "fontSize": 15,
      "fontWeight": "bold",
      "color": "#1d2a35",
      "subtitleFont": "Atkinson Hyperlegible",
      "subtitleColor": "#5b6670",
      "subtitleFontSize": 12,
      "subtitlePadding": 4,
      "offset": 12
    },
    "header": {
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "text": {
      "font": "Atkinson Hyperlegible"
    }
  }
}