{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "As screens move into bedtime, sleep shrinks",
    "subtitle": "Each dot is an age group, 2023"
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/nnpas_sleep_screens.csv",
    "format": {
      "type": "csv",
      "parse": {
        "order": "number",
        "screens_before_bed_pct": "number",
        "screen_in_bedroom_pct": "number",
        "sleep_min": "number"
      }
    }
  },
  "encoding": {
    "x": {
      "field": "screens_before_bed_pct",
      "type": "quantitative",
      "title": "% who used a screen in the hour before bed",
      "scale": {
        "domain": [
          30,
          100
        ]
      }
    },
    "y": {
      "field": "sleep_min",
      "type": "quantitative",
      "title": "Average sleep (hours)",
      "scale": {
        "domain": [
          510,
          640
        ]
      },
      "axis": {
        "values": [
          510,
          540,
          570,
          600,
          630
        ],
        "labelExpr": "floor(datum.value/60) + 'h ' + (datum.value % 60 == 0 ? '00' : datum.value % 60)"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "trail",
        "color": "#d9b7a0"
      },
      "encoding": {
        "order": {
          "field": "order",
          "type": "quantitative"
        },
        "size": {
          "field": "order",
          "type": "quantitative",
          "scale": {
            "range": [
              1.5,
              5
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 150,
        "opacity": 1,
        "stroke": "#ffffff",
        "strokeWidth": 2,
        "color": "#b3561a"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "age_group",
            "title": "Age"
          },
          {
            "field": "screens_before_bed_pct",
            "title": "% screens before bed"
          },
          {
            "field": "sleep_label",
            "title": "Average sleep"
          },
          {
            "field": "screen_in_bedroom_pct",
            "title": "% with a screen in bedroom"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 11,
        "dy": -9,
        "fontSize": 11.5,
        "fontWeight": "bold",
        "color": "#1d2a35"
      },
      "encoding": {
        "text": {
          "field": "age_group"
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.sleep_label",
          "as": "s"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 11,
        "dy": 6,
        "fontSize": 10.5,
        "color": "#5b6670"
      },
      "encoding": {
        "text": {
          "field": "s"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 86.7,
            "y": 530,
            "t": "94% of 15–17s keep a screen in the bedroom"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "dy": 20,
        "fontSize": 10.5,
        "fontWeight": "bold",
        "color": "#7a3510"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "font": "Atkinson Hyperlegible",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b6670",
      "titleColor": "#5b6670",
      "gridColor": "#e7e9e8",
      "domainColor": "#b8bec2",
      "tickColor": "#b8bec2",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "legend": {
      "labelColor": "#5b6670",
      "titleColor": "#1d2a35",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "title": {
      "anchor": "start",
      "font": "Atkinson Hyperlegible",
      "fontSize": 15,
      "fontWeight": "bold",
      "color": "#1d2a35",
      "subtitleFont": "Atkinson Hyperlegible",
      "subtitleColor": "#5b6670",
      "subtitleFontSize": 12,
      "subtitlePadding": 4,
      "offset": 12
    },
    "header": {
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "text": {
      "font": "Atkinson Hyperlegible"
    }
  }
}