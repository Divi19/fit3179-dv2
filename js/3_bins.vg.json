{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Change in share vulnerable on 1+ domains, 2021 → 2024 ·",
      "councils grouped into equal-sized hexagons (~100 km) ·",
      "hexes with fewer than 100 children hidden"
    ],
    "fontSize": 14,
    "fontWeight": "normal",
    "color": "#5b6570",
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "lineHeight": 18
  },
  "width": "container",
  "height": 440,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133.5,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_lga.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef0ee",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/aedc_lga.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lga_code": "string",
            "year": "number",
            "children_assessed": "number",
            "vulnerable_n": "number",
            "vulnerable_pct": "number",
            "lon": "number",
            "lat": "number",
            "hex_id": "string"
          }
        }
      },
      "transform": [
        {
          "filter": "(datum.year == 2021 || datum.year == 2024) && isValid(datum.vulnerable_n) && isValid(datum.children_assessed)"
        },
        {
          "joinaggregate": [
            {
              "op": "count",
              "as": "years_present"
            }
          ],
          "groupby": [
            "lga_code"
          ]
        },
        {
          "filter": "datum.years_present == 2"
        },
        {
          "calculate": "datum.year == 2021 ? datum.vulnerable_n : 0",
          "as": "n21"
        },
        {
          "calculate": "datum.year == 2021 ? datum.children_assessed : 0",
          "as": "c21"
        },
        {
          "calculate": "datum.year == 2024 ? datum.vulnerable_n : 0",
          "as": "n24"
        },
        {
          "calculate": "datum.year == 2024 ? datum.children_assessed : 0",
          "as": "c24"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "n21",
              "as": "n21"
            },
            {
              "op": "sum",
              "field": "c21",
              "as": "c21"
            },
            {
              "op": "sum",
              "field": "n24",
              "as": "n24"
            },
            {
              "op": "sum",
              "field": "c24",
              "as": "c24"
            },
            {
              "op": "distinct",
              "field": "lga_code",
              "as": "councils"
            },
            {
              "op": "argmax",
              "field": "c24",
              "as": "largest"
            }
          ],
          "groupby": [
            "hex_id"
          ]
        },
        {
          "filter": "datum.c21 >= 100 && datum.c24 >= 100"
        },
        {
          "lookup": "hex_id",
          "from": {
            "data": {
              "url": "data/hex_grid.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.hex_id"
          },
          "as": "geo"
        },
        {
          "calculate": "datum.largest.lga_name",
          "as": "largest_name"
        },
        {
          "calculate": "datum.geo.properties.cx",
          "as": "cx"
        },
        {
          "calculate": "datum.geo.properties.cy",
          "as": "cy"
        },
        {
          "calculate": "100 * datum.n21 / datum.c21",
          "as": "pct21"
        },
        {
          "calculate": "100 * datum.n24 / datum.c24",
          "as": "pct24"
        },
        {
          "calculate": "datum.pct24 - datum.pct21",
          "as": "change"
        },
        {
          "calculate": "(datum.change > 0 ? '+' : '') + format(datum.change, '.1f') + ' points'",
          "as": "change_label"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "change",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              -4,
              -1,
              1,
              4
            ],
            "range": [
              "#0a74c4",
              "#9ccaee",
              "#e6e7e4",
              "#f5a25e",
              "#d0571b"
            ]
          },
          "legend": {
            "title": "Change since 2021 (points)",
            "orient": "right",
            "direction": "vertical",
            "gradientLength": 180,
            "gradientThickness": 14,
            "labelExpr": "datum.index == 0 ? 'Better by 4+' : datum.index == 1 ? 'Better by 1–4' : datum.index == 2 ? 'Little change' : datum.index == 3 ? 'Worse by 1–4' : 'Worse by 4+'"
          }
        },
        "tooltip": [
          {
            "field": "change_label",
            "title": "Change since 2021"
          },
          {
            "field": "pct21",
            "title": "2021 share (%)",
            "format": ".1f"
          },
          {
            "field": "pct24",
            "title": "2024 share (%)",
            "format": ".1f"
          },
          {
            "field": "councils",
            "title": "Councils in hexagon"
          },
          {
            "field": "largest_name",
            "title": "Largest council"
          },
          {
            "field": "c24",
            "title": "Children assessed 2024",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/aus_lga.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#46525d",
        "strokeWidth": 0.9
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 89.0,
            "lat": -30.0
          }
        ]
      },
      "mark": {
        "type": "point",
        "opacity": 0,
        "size": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      },
      "description": "Invisible anchor so the map leaves room for the callout labels in the Indian Ocean"
    },
    {
      "data": {
        "url": "data/aedc_lga.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lga_code": "string",
