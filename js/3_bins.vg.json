        },
        {
          "calculate": "replace(datum.largest_name, ' area', '') + '\\narea: +' + format(datum.change, '.1f') + ' points'",
          "as": "callout"
        },
        {
          "calculate": "datum.largest_name == 'Greater Geraldton' ? 93.2 : datum.largest_name == 'Mandurah' ? 88.43 : datum.largest_name == 'Greater Shepparton' ? 113.53 : datum.cx + 2",
          "as": "lx"
        },
        {
          "calculate": "datum.largest_name == 'Greater Geraldton' ? -19.15 : datum.largest_name == 'Mandurah' ? -31.31 : datum.largest_name == 'Greater Shepparton' ? -44.04 : datum.cy",
          "as": "ly"
        },
        {
          "calculate": "datum.largest_name == 'Greater Geraldton' ? 112.6 : datum.largest_name == 'Mandurah' ? 108.44 : datum.largest_name == 'Greater Shepparton' ? 137.79 : datum.cx + 1.5",
          "as": "sx"
        },
        {
          "calculate": "datum.largest_name == 'Greater Geraldton' ? -23.51 : datum.largest_name == 'Mandurah' ? -35.96 : datum.largest_name == 'Greater Shepparton' ? -44.48 : datum.cy",
          "as": "sy"
        },
        {
          "calculate": "cos(datum.cy * PI / 180)",
          "as": "k"
        },
        {
          "calculate": "(datum.cx - datum.sx) * datum.k",
          "as": "ddx"
        },
        {
          "calculate": "datum.cy - datum.sy",
          "as": "ddy"
        },
        {
          "calculate": "sqrt(datum.ddx * datum.ddx + datum.ddy * datum.ddy)",
          "as": "dd"
        },
        {
          "calculate": "datum.cx - (datum.ddx / datum.dd) * 0.62 / datum.k",
          "as": "tx"
        },
        {
          "calculate": "datum.cy - (datum.ddy / datum.dd) * 0.62",
          "as": "ty"
        },
        {
          "calculate": "atan2(datum.ddx, datum.ddy) * 180 / PI",
          "as": "angle"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "lineBreak": "\n",
        "fontSize": 13,
        "fontWeight": "bold",
        "lineHeight": 15,
        "color": "#8e3410"
      },
      "encoding": {
        "longitude": {
          "field": "lx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "ly",
          "type": "quantitative"
        },
        "text": {
          "field": "callout"
        }
      }
    }
