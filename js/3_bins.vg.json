      },
      "transform": [
        {
          "filter": "(datum.year == 2021 || datum.year == 2024) && isValid(datum.vulnerable_n) && isValid(datum.children_assessed)"
        },
        {
          "joinaggregate": [
            {
              "op": "count",
              "as": "years_present"
            }
          ],
          "groupby": [
            "lga_code"
          ]
        },
        {
          "filter": "datum.years_present == 2"
        },
        {
          "calculate": "datum.year == 2021 ? datum.vulnerable_n : 0",
          "as": "n21"
        },
        {
          "calculate": "datum.year == 2021 ? datum.children_assessed : 0",
          "as": "c21"
        },
        {
          "calculate": "datum.year == 2024 ? datum.vulnerable_n : 0",
          "as": "n24"
        },
        {
          "calculate": "datum.year == 2024 ? datum.children_assessed : 0",
          "as": "c24"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "n21",
              "as": "n21"
            },
            {
              "op": "sum",
              "field": "c21",
              "as": "c21"
            },
            {
              "op": "sum",
              "field": "n24",
              "as": "n24"
            },
            {
              "op": "sum",
              "field": "c24",
              "as": "c24"
            },
            {
              "op": "distinct",
              "field": "lga_code",
              "as": "councils"
            },
            {
              "op": "argmax",
              "field": "c24",
              "as": "largest"
            }
          ],
          "groupby": [
            "hex_id"
          ]
        },
        {
          "filter": "datum.c21 >= 100 && datum.c24 >= 100"
        },
        {
          "lookup": "hex_id",
          "from": {
            "data": {
              "url": "data/hex_grid.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.hex_id"
          },
          "as": "geo"
        },
        {
          "calculate": "datum.largest.lga_name",
          "as": "largest_name"
        },
        {
          "calculate": "datum.geo.properties.cx",
          "as": "cx"
        },
        {
          "calculate": "datum.geo.properties.cy",
          "as": "cy"
        },
        {
          "calculate": "100 * datum.n21 / datum.c21",
          "as": "pct21"
        },
        {
          "calculate": "100 * datum.n24 / datum.c24",
          "as": "pct24"
        },
        {
          "calculate": "datum.pct24 - datum.pct21",
          "as": "change"
        },
        {
          "calculate": "(datum.change > 0 ? '+' : '') + format(datum.change, '.1f') + ' points'",
          "as": "change_label"
        },
        {
          "filter": "datum.c24 >= 500"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rise_rank"
            }
          ],
          "sort": [
            {
              "field": "change",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rise_rank <= 3"
        },
        {
          "calculate": "replace(datum.largest_name, ' area', '') + '\\narea: +' + format(datum.change, '.1f') + ' points'",
          "as": "callout"
        },
        {
          "calculate": "datum.largest_name == 'Greater Geraldton' ? 93.2 : datum.largest_name == 'Mandurah' ? 88.43 : datum.largest_name == 'Greater Shepparton' ? 113.53 : datum.cx + 2",
          "as": "lx"
        },
        {
          "calculate": "datum.largest_name == 'Greater Geraldton' ? -19.15 : datum.largest_name == 'Mandurah' ? -31.31 : datum.largest_name == 'Greater Shepparton' ? -44.04 : datum.cy",
          "as": "ly"
        },
        {
          "calculate": "datum.largest_name == 'Greater Geraldton' ? 112.6 : datum.largest_name == 'Mandurah' ? 108.44 : datum.largest_name == 'Greater Shepparton' ? 137.79 : datum.cx + 1.5",
          "as": "sx"
        },
        {
          "calculate": "datum.largest_name == 'Greater Geraldton' ? -23.51 : datum.largest_name == 'Mandurah' ? -35.96 : datum.largest_name == 'Greater Shepparton' ? -44.48 : datum.cy",
          "as": "sy"
        },
        {
          "calculate": "cos(datum.cy * PI / 180)",
          "as": "k"
        },
        {
          "calculate": "(datum.cx - datum.sx) * datum.k",
          "as": "ddx"
        },
        {
          "calculate": "datum.cy - datum.sy",
          "as": "ddy"
        },
        {
          "calculate": "sqrt(datum.ddx * datum.ddx + datum.ddy * datum.ddy)",
          "as": "dd"
        },
        {
          "calculate": "datum.cx - (datum.ddx / datum.dd) * 0.62 / datum.k",
          "as": "tx"
        },
        {
          "calculate": "datum.cy - (datum.ddy / datum.dd) * 0.62",
          "as": "ty"
        },
        {
          "calculate": "atan2(datum.ddx, datum.ddy) * 180 / PI",
          "as": "angle"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#8e3410",
        "strokeWidth": 1.3
      },
      "encoding": {
        "longitude": {
          "field": "sx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "sy",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "tx"
        },
        "latitude2": {
          "field": "ty"
        }
      }
    },
