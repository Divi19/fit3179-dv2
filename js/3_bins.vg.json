          "calculate": "datum.pct24 - datum.pct21",
          "as": "change"
        },
        {
          "calculate": "(datum.change > 0 ? '+' : '') + format(datum.change, '.1f') + ' points'",
          "as": "change_label"
        },
        {
          "filter": "datum.c24 >= 500"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rise_rank"
            }
          ],
          "sort": [
            {
              "field": "change",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rise_rank <= 3"
        },
        {
          "calculate": "datum.largest_name + ' area +' + format(datum.change, '.1f')",
          "as": "callout"
        },
        {
          "filter": "datum.cx >= 140"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -9,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#ffffff",
        "stroke": "#ffffff",
        "strokeWidth": 3,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {
          "field": "cx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "cy",
          "type": "quantitative"
        },
        "text": {
          "field": "callout"
        }
      }
    },
    {
      "data": {
        "url": "data/aedc_lga.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lga_code": "string",
            "year": "number",
            "children_assessed": "number",
            "vulnerable_n": "number",
            "vulnerable_pct": "number",
            "lon": "number",
            "lat": "number",
            "hex_id": "string"
          }
        }
      },
      "transform": [
        {
          "filter": "(datum.year == 2021 || datum.year == 2024) && isValid(datum.vulnerable_n) && isValid(datum.children_assessed)"
        },
        {
          "joinaggregate": [
            {
              "op": "count",
              "as": "years_present"
            }
          ],
          "groupby": [
            "lga_code"
          ]
        },
        {
          "filter": "datum.years_present == 2"
        },
        {
          "calculate": "datum.year == 2021 ? datum.vulnerable_n : 0",
          "as": "n21"
        },
        {
          "calculate": "datum.year == 2021 ? datum.children_assessed : 0",
          "as": "c21"
        },
        {
          "calculate": "datum.year == 2024 ? datum.vulnerable_n : 0",
          "as": "n24"
        },
        {
          "calculate": "datum.year == 2024 ? datum.children_assessed : 0",
          "as": "c24"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "n21",
              "as": "n21"
            },
            {
              "op": "sum",
              "field": "c21",
              "as": "c21"
            },
            {
              "op": "sum",
              "field": "n24",
              "as": "n24"
            },
            {
              "op": "sum",
              "field": "c24",
              "as": "c24"
            },
            {
              "op": "distinct",
              "field": "lga_code",
              "as": "councils"
            },
            {
              "op": "argmax",
              "field": "c24",
              "as": "largest"
            }
          ],
          "groupby": [
            "hex_id"
          ]
        },
        {
          "filter": "datum.c21 >= 100 && datum.c24 >= 100"
        },
        {
          "lookup": "hex_id",
          "from": {
            "data": {
              "url": "data/hex_grid.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.hex_id"
          },
          "as": "geo"
        },
        {
          "calculate": "datum.largest.lga_name",
          "as": "largest_name"
        },
        {
          "calculate": "datum.geo.properties.cx",
          "as": "cx"
        },
        {
          "calculate": "datum.geo.properties.cy",
          "as": "cy"
        },
        {
          "calculate": "100 * datum.n21 / datum.c21",
          "as": "pct21"
        },
        {
          "calculate": "100 * datum.n24 / datum.c24",
          "as": "pct24"
        },
        {
          "calculate": "datum.pct24 - datum.pct21",
          "as": "change"
        },
        {
          "calculate": "(datum.change > 0 ? '+' : '') + format(datum.change, '.1f') + ' points'",
          "as": "change_label"
        },
        {
          "filter": "datum.c24 >= 500"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rise_rank"
            }
          ],
          "sort": [
            {
              "field": "change",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rise_rank <= 3"
        },
        {
          "calculate": "datum.largest_name + ' area +' + format(datum.change, '.1f')",
          "as": "callout"
        },
        {
          "filter": "datum.cx >= 140"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -9,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#7a3510"
      },
      "encoding": {
        "longitude": {
          "field": "cx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "cy",
          "type": "quantitative"
        },
        "text": {
          "field": "callout"
        }
      }
    }
