{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Your council matters more than your state",
    "subtitle": "Share vulnerable on 1+ domains in each council, 2024 · box = middle half of councils · dots = individual councils"
  },
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/aedc_lga.csv",
    "format": {
      "type": "csv",
      "parse": {
        "lga_code": "string",
        "year": "number",
        "children_assessed": "number",
        "vulnerable_n": "number",
        "vulnerable_pct": "number",
        "lon": "number",
        "lat": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year == 2024 && isValid(datum.vulnerable_pct) && datum.state != 'ACT'"
    },
    {
      "calculate": "datum.vulnerable_pct >= 90 ? '90% or more' : format(datum.vulnerable_pct,'.1f') + '%'",
      "as": "pct_label"
    },
    {
      "calculate": "random()",
      "as": "jitter"
    }
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": [
        "NT",
        "QLD",
        "TAS",
        "NSW",
        "WA",
        "VIC",
        "SA"
      ],
      "axis": {
        "labelFontWeight": "bold",
        "labelColor": "#1d2a35",
        "labelFontSize": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 26,
        "color": "#f6d2a9",
        "median": {
          "color": "#7a3510",
          "strokeWidth": 2.5
        },
        "rule": {
          "color": "#b8bec2"
        },
        "box": {
          "stroke": "#d97d33"
        },
        "ticks": false
      },
      "encoding": {
        "x": {
          "field": "vulnerable_pct",
          "type": "quantitative",
          "title": "% of children vulnerable on 1+ domains",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 22,
        "opacity": 0.55,
        "color": "#7a3510"
      },
      "encoding": {
        "x": {
          "field": "vulnerable_pct",
          "type": "quantitative"
        },
        "yOffset": {
          "field": "jitter",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1,
              2
            ]
          }
        },
        "tooltip": [
          {
            "field": "lga_name",
            "title": "Council"
          },
          {
            "field": "pct_label",
            "title": "Vulnerable on 1+ domains"
          },
          {
            "field": "children_assessed",
            "title": "Children assessed",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 23.5
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          3
        ],
        "color": "#1d2a35"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": {
            "expr": "height"
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 23.5,
            "t": "Australia 23.5%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "dy": -6,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#1d2a35"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "font": "Atkinson Hyperlegible",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b6670",
      "titleColor": "#5b6670",
      "gridColor": "#e7e9e8",
      "domainColor": "#b8bec2",
      "tickColor": "#b8bec2",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "legend": {
      "labelColor": "#5b6670",
      "titleColor": "#1d2a35",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "title": {
      "anchor": "start",
      "font": "Atkinson Hyperlegible",
      "fontSize": 15,
      "fontWeight": "bold",
      "color": "#1d2a35",
      "subtitleFont": "Atkinson Hyperlegible",
      "subtitleColor": "#5b6670",
      "subtitleFontSize": 12,
      "subtitlePadding": 4,
      "offset": 12
    },
    "header": {
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "text": {
      "font": "Atkinson Hyperlegible"
    }
  }
}