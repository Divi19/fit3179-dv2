{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Your council matters more than your state",
    "subtitle": "Each dot is one council: % of its children vulnerable on 1+ domains, 2024"
  },
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/aedc_lga.csv",
    "format": {
      "type": "csv",
      "parse": {
        "lga_code": "string",
        "year": "number",
        "children_assessed": "number",
        "vulnerable_n": "number",
        "vulnerable_pct": "number",
        "lon": "number",
        "lat": "number",
        "hex_id": "string"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year == 2024 && isValid(datum.vulnerable_pct) && datum.state != 'ACT'"
    },
    {
      "calculate": "datum.vulnerable_pct >= 90 ? '90% or more' : format(datum.vulnerable_pct, '.1f') + '%'",
      "as": "pct_label"
    },
    {
      "calculate": "datum.lga_name == 'Tiwi Islands' ? 'Tied highest in Australia with West Daly (results are capped at 90%)' : ''",
      "as": "note"
    },
    {
      "calculate": "random()",
      "as": "jitter"
    }
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "sort": [
        "NT",
        "QLD",
        "TAS",
        "NSW",
        "WA",
        "VIC",
        "SA"
      ],
      "axis": {
        "labelFontWeight": "bold",
        "labelColor": "#1d2a35",
        "labelFontSize": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 26,
        "color": "#f6d2a9",
        "median": {
          "color": "#7a3510",
          "strokeWidth": 2.5
        },
        "rule": {
          "color": "#b8bec2"
        },
        "box": {
          "stroke": "#d97d33"
        },
        "ticks": false
      },
      "encoding": {
        "x": {
          "field": "vulnerable_pct",
          "type": "quantitative",
          "title": "% of children vulnerable on 1+ domains",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 22,
        "opacity": 0.55,
        "color": "#7a3510"
      },
      "encoding": {
        "x": {
          "field": "vulnerable_pct",
          "type": "quantitative",
          "title": "% of children vulnerable on 1+ domains",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "yOffset": {
          "field": "jitter",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1,
              2
            ]
          }
        },
        "tooltip": [
          {
            "field": "lga_name",
            "title": "Council"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "pct_label",
            "title": "Vulnerable on 1+ domains"
          },
          {
            "field": "children_assessed",
            "title": "Children assessed",
            "format": ","
          },
          {
            "field": "note",
            "title": "Note"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "indexof(['Brisbane', 'Weipa', 'Cherbourg', 'Tiwi Islands'], datum.lga_name) >= 0"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 44,
        "opacity": 1,
        "color": "#7a3510",
        "stroke": "#1d2a35",
        "strokeWidth": 1.6
      },
      "encoding": {
        "x": {
          "field": "vulnerable_pct",
          "type": "quantitative",
          "title": "% of children vulnerable on 1+ domains",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "yOffset": {
          "field": "jitter",
          "type": "quantitative",
          "scale": {
            "domain": [
              -1,
              2
            ]
          }
        },
        "tooltip": [
          {
            "field": "lga_name",
            "title": "Council"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "pct_label",
            "title": "Vulnerable on 1+ domains"
          },
          {
            "field": "children_assessed",
            "title": "Children assessed",
            "format": ","
          },
          {
            "field": "note",
            "title": "Note"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "indexof(['Brisbane', 'Weipa'], datum.lga_name) >= 0"
        },
        {
          "calculate": "datum.lga_name + ' ' + (datum.vulnerable_pct >= 90 ? '90%+' : format(datum.vulnerable_pct, '.1f') + '%')",
          "as": "t"
