{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "By the late teens, screens take nearly four times as long as activity",
    "subtitle": "Average minutes per day, 2023 · ages 5–17"
  },
  "width": "container",
  "height": 270,
  "params": [
    {
      "name": "sex",
      "value": "All",
      "bind": {
        "input": "radio",
        "options": [
          "All",
          "Boys",
          "Girls"
        ],
        "name": "Show: "
      }
    }
  ],
  "data": {
    "url": "data/nnpas_activity_screens.csv",
    "format": {
      "type": "csv",
      "parse": {
        "age_order": "number",
        "activity_min": "number",
        "screen_min": "number",
        "activity_rse": "number",
        "screen_rse": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.sex == sex"
    },
    {
      "calculate": "datum.screen_min / datum.activity_min",
      "as": "ratio"
    },
    {
      "fold": [
        "activity_min",
        "screen_min"
      ],
      "as": [
        "key",
        "minutes"
      ]
    },
    {
      "calculate": "datum.key == 'activity_min' ? 'Active (moderate–vigorous)' : 'Sedentary screen time'",
      "as": "measure"
    },
    {
      "calculate": "datum.key == 'activity_min' ? -datum.minutes : datum.minutes",
      "as": "signed"
    },
    {
      "calculate": "(datum.minutes >= 60 ? floor(datum.minutes / 60) + 'h' + (datum.minutes % 60 == 0 ? '' : ' ' + (datum.minutes % 60) + 'm') : datum.minutes + 'm')",
      "as": "hm"
    },
    {
      "calculate": "datum.key == 'activity_min' ? datum.activity_rse : datum.screen_rse",
      "as": "rse"
    },
    {
      "calculate": "isValid(datum.rse) ? 'RSE ' + format(datum.rse, '.1f') + '%' : 'not published'",
      "as": "rse_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "age_group",
      "type": "ordinal",
      "title": null,
      "sort": [
        "5–8",
        "9–11",
        "12–14",
        "15–17"
      ],
      "scale": {
        "paddingOuter": 0.45
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontWeight": "bold",
        "labelColor": "#1d2a35",
        "labelFontSize": 12,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.62
        },
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "x": {
          "field": "signed",
          "type": "quantitative",
          "title": "hours per day",
          "scale": {
            "domain": [
              -170,
              290
            ]
          },
          "axis": {
            "values": [
              -120,
              -60,
              0,
              60,
              120,
              180,
              240
            ],
            "labelExpr": "datum.value == 0 ? '0' : abs(datum.value) / 60 + 'h'",
            "grid": true
          }
        },
        "color": {
          "field": "measure",
          "type": "nominal",
          "scale": {
            "domain": [
              "Active (moderate–vigorous)",
              "Sedentary screen time"
            ],
            "range": [
              "#007c9e",
              "#cf6a12"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "sex",
            "title": "Group"
          },
          {
            "field": "age_group",
            "title": "Age"
          },
          {
            "field": "measure",
            "title": "Measure"
          },
          {
            "field": "hm",
            "title": "Time per day"
          },
          {
            "field": "minutes",
            "title": "Minutes per day"
          },
          {
            "field": "rse_label",
            "title": "Relative standard error"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.key == 'activity_min'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -5,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#1d2a35"
      },
      "encoding": {
        "x": {
          "field": "signed",
          "type": "quantitative"
        },
        "text": {
          "field": "hm"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.key == 'screen_min'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#1d2a35"
      },
      "encoding": {
        "x": {
          "field": "signed",
          "type": "quantitative"
        },
        "text": {
          "field": "hm"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": -60
          },
          {
            "x": 120
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          3
        ],
        "color": "#1d2a35",
        "opacity": 0.7
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": {
            "expr": "height"
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": -60,
            "t": "Guideline: 60+ min"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "dx": -4,
        "fontSize": 10,
        "color": "#1d2a35"
      },
      "encoding": {
        "y": {
          "value": 3
        },
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 120,
            "t": "Limit: 2 h"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 4,
        "fontSize": 10,
        "color": "#1d2a35"
      },
      "encoding": {
        "y": {
          "value": 3
        },
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#8f979c"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": {
            "expr": "height"
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": -6,
            "t": "← Active (moderate–vigorous)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#007c9e"
      },
      "encoding": {
        "y": {
          "value": -6
        },
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 6,
            "t": "Sedentary screen time →"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#cf6a12"
      },
      "encoding": {
        "y": {
          "value": -6
        },
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.key == 'screen_min' && datum.age_order == 0"
        },
        {
          "calculate": "datum.minutes + 48",
          "as": "lx"
        },
        {
          "calculate": "'About even at ' + datum.age_group",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#5b6670"
      },
      "encoding": {
        "x": {
          "field": "lx",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.key == 'screen_min' && datum.age_order == 3"
        },
        {
          "calculate": "'Screens ≈ ' + format(datum.ratio, '.1f') + '× activity'",
          "as": "t"
        },
        {
          "calculate": "8",
          "as": "lx"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "lx",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "font": "Atkinson Hyperlegible",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b6670",
      "titleColor": "#5b6670",
      "gridColor": "#e7e9e8",
      "domainColor": "#b8bec2",
      "tickColor": "#b8bec2",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "legend": {
      "labelColor": "#5b6670",
      "titleColor": "#1d2a35",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "title": {
      "anchor": "start",
      "font": "Atkinson Hyperlegible",
      "fontSize": 15,
      "fontWeight": "bold",
      "color": "#1d2a35",
      "subtitleFont": "Atkinson Hyperlegible",
      "subtitleColor": "#5b6670",
      "subtitleFontSize": 12,
      "subtitlePadding": 4,
      "offset": 12
    },
    "header": {
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "text": {
      "font": "Atkinson Hyperlegible"
    }
  }
}
