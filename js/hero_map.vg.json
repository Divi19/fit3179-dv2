{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Hero map: every council as a circle sized by its number of developmentally vulnerable children, 2024 (AEDC).",
  "width": "container",
  "height": 440,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133.5,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_lga.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4f2ee",
        "stroke": "#1c2430",
        "strokeWidth": 1.1
      }
    },
    {
      "data": {
        "url": "data/aedc_lga.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "children_assessed": "number",
            "vulnerable_n": "number",
            "vulnerable_pct": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == 2024 && isValid(datum.vulnerable_n) && datum.vulnerable_n > 0 && isValid(datum.lon)"
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#d0571b",
        "fillOpacity": 0.3,
        "stroke": "#8e3410",
        "strokeWidth": 0.8,
        "strokeOpacity": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "vulnerable_n",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              2756
            ],
            "range": [
              0,
              1700
            ]
          },
          "legend": null
        },
        "order": {
          "field": "vulnerable_n",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "lga_name",
            "title": "Council"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "vulnerable_n",
            "title": "Vulnerable children, 2024",
            "format": ","
          },
          {
            "field": "vulnerable_pct",
            "title": "% vulnerable",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/aedc_lga.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "children_assessed": "number",
            "vulnerable_n": "number",
            "vulnerable_pct": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == 2024 && datum.lga_name == 'Brisbane'"
        },
        {
          "calculate": "datum.lga_name + ' ' + format(datum.vulnerable_n, ',')",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -30,
        "dy": -24,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#1c2430"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "font": "Atkinson Hyperlegible",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#46525d",
      "titleColor": "#46525d",
      "gridColor": "#e7e9e8",
      "domainColor": "#b8bec2",
      "tickColor": "#b8bec2",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "legend": {
      "labelColor": "#46525d",
      "titleColor": "#1c2430",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "title": {
      "anchor": "start",
      "font": "Atkinson Hyperlegible",
      "fontSize": 15,
      "fontWeight": "bold",
      "color": "#1c2430",
      "subtitleFont": "Atkinson Hyperlegible",
      "subtitleColor": "#46525d",
      "subtitleFontSize": 12,
      "subtitlePadding": 4,
      "offset": 12
    },
    "header": {
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "text": {
      "font": "Atkinson Hyperlegible"
    }
  }
}