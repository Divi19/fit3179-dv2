{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "% of children developmentally vulnerable in each area, Australia, 2009–2024 · dashed line = 2009 level",
    "fontSize": 14,
    "fontWeight": 500,
    "color": "#b3bcc5",
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "lineHeight": 18
  },
  "data": {
    "url": "data/aedc_domains_national.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "vulnerable_pct": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "first_value",
          "field": "vulnerable_pct",
          "as": "base"
        }
      ],
      "sort": [
        {
          "field": "year"
        }
      ],
      "groupby": [
        "domain"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "vulnerable_pct",
          "as": "max_pct"
        },
        {
          "op": "min",
          "field": "vulnerable_pct",
          "as": "min_pct"
        }
      ],
      "groupby": [
        "domain"
      ]
    },
    {
      "window": [
        {
          "op": "count",
          "as": "n_at_max"
        }
      ],
      "groupby": [
        "domain",
        "vulnerable_pct"
      ],
      "frame": [
        null,
        null
      ]
    }
  ],
  "facet": {
    "field": "domain",
    "type": "nominal",
    "sort": [
      "Physical health",
      "Social competence",
      "Emotional maturity",
      "Language and thinking",
      "Communication"
    ],
    "title": null,
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": "bold",
      "labelColor": "#efe6d6",
      "labelAnchor": "start",
      "labelPadding": 6
    }
  },
  "columns": 3,
  "spacing": {
    "row": 44,
    "column": 40
  },
  "spec": {
    "width": 318,
    "height": 240,
    "layer": [
      {
        "mark": {
          "type": "rule",
          "strokeDash": [
            4,
            3
          ],
          "color": "#94a0ab",
          "strokeWidth": 1
        },
        "transform": [
          {
            "filter": "datum.year == 2009"
          }
        ],
        "encoding": {
          "y": {
            "field": "base",
            "type": "quantitative",
            "title": "% vulnerable",
            "scale": {
              "domain": [
                5,
                12
              ],
              "zero": false
            },
            "axis": {
              "values": [
                6,
                8,
                10,
                12
              ],
              "labelExpr": "datum.value + '%'",
              "tickCount": 4
            }
          },
          "tooltip": [
            {
              "field": "domain_full",
              "title": "Area"
            },
            {
              "field": "base",
              "title": "2009 level (%)",
              "format": ".1f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "right",
          "baseline": "top",
          "dy": 4,
          "fontSize": 12,
          "color": "#b3bcc5"
        },
        "transform": [
          {
            "filter": "datum.year == 2024 && datum.domain == 'Physical health'"
          },
          {
            "calculate": "'2009 level'",
            "as": "t"
          }
        ],
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "title": null,
            "scale": {
              "domain": [
                2008,
                2025
              ]
            },
            "axis": {
              "values": [
                2009,
                2015,
                2021,
                2024
              ],
              "format": "d",
              "grid": false,
              "labelFontSize": 12
            }
          },
          "y": {
            "field": "base",
            "type": "quantitative",
            "title": "% vulnerable",
            "scale": {
              "domain": [
                5,
                12
              ],
              "zero": false
            },
            "axis": {
              "values": [
                6,
                8,
                10,
                12
              ],
              "labelExpr": "datum.value + '%'",
              "tickCount": 4
            }
          },
          "text": {
            "field": "t"
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "color": "#e3652a",
          "strokeWidth": 2
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "title": null,
            "scale": {
              "domain": [
                2008,
                2025
              ]
            },
            "axis": {
              "values": [
                2009,
                2015,
                2021,
                2024
              ],
              "format": "d",
              "grid": false,
              "labelFontSize": 12
            }
          },
          "y": {
            "field": "vulnerable_pct",
            "type": "quantitative",
            "title": "% vulnerable",
            "scale": {
              "domain": [
                5,
                12
              ],
              "zero": false
            },
            "axis": {
              "values": [
                6,
                8,
                10,
                12
              ],
              "labelExpr": "datum.value + '%'",
              "tickCount": 4
            }
          }
        }
      },
      {
        "mark": {
          "type": "point",
          "filled": true,
          "color": "#e3652a",
          "size": 36,
          "opacity": 1
        },
        "transform": [
          {
            "filter": "datum.year < 2024"
          }
        ],
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "title": null,
            "scale": {
              "domain": [
                2008,
                2025
              ]
            },
            "axis": {
              "values": [
                2009,
                2015,
                2021,
                2024
              ],
              "format": "d",
              "grid": false,
              "labelFontSize": 12
            }
          },
          "y": {
            "field": "vulnerable_pct",
            "type": "quantitative",
            "title": "% vulnerable",
            "scale": {
              "domain": [
                5,
                12
              ],
              "zero": false
            },
            "axis": {
              "values": [
                6,
                8,
                10,
                12
              ],
              "labelExpr": "datum.value + '%'",
              "tickCount": 4
            }
          },
          "tooltip": [
            {
              "field": "domain_full",
              "title": "Area"
            },
            {
              "field": "year",
              "title": "Year"
            },
            {
              "field": "vulnerable_pct",
              "title": "% vulnerable",
              "format": ".1f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "point",
          "filled": true,
          "color": "#ff9b63",
          "size": 110,
          "opacity": 1,
          "stroke": "#142231",
          "strokeWidth": 1.5
        },
        "transform": [
          {
            "filter": "datum.year == 2024"
          }
        ],
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "title": null,
            "scale": {
              "domain": [
                2008,
                2025
              ]
            },
            "axis": {
              "values": [
                2009,
                2015,
                2021,
                2024
              ],
              "format": "d",
              "grid": false,
              "labelFontSize": 12
            }
          },
          "y": {
            "field": "vulnerable_pct",
            "type": "quantitative",
            "title": "% vulnerable",
            "scale": {
              "domain": [
                5,
                12
              ],
              "zero": false
            },
            "axis": {
              "values": [
                6,
                8,
                10,
                12
              ],
              "labelExpr": "datum.value + '%'",
              "tickCount": 4
            }
          },
          "tooltip": [
            {
              "field": "domain_full",
              "title": "Area"
            },
            {
              "field": "year",
              "title": "Year"
            },
            {
              "field": "vulnerable_pct",
              "title": "% vulnerable",
              "format": ".1f"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "right",
          "baseline": "bottom",
          "dx": 6,
          "dy": -9,
          "fontSize": 13,
          "fontWeight": "bold",
          "color": "#ff9b63"
        },
        "transform": [
          {
            "filter": "datum.year == 2024"
          },
          {
            "calculate": "format(datum.vulnerable_pct, '.1f') + '%'",
            "as": "t"
          }
        ],
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "title": null,
            "scale": {
              "domain": [
                2008,
                2025
              ]
            },
            "axis": {
              "values": [
                2009,
                2015,
                2021,
                2024
              ],
              "format": "d",
              "grid": false,
              "labelFontSize": 12
            }
          },
          "y": {
            "field": "vulnerable_pct",
            "type": "quantitative",
            "title": "% vulnerable",
            "scale": {
              "domain": [
                5,
                12
              ],
              "zero": false
            },
            "axis": {
              "values": [
                6,
                8,
                10,
                12
              ],
              "labelExpr": "datum.value + '%'",
              "tickCount": 4
            }
          },
          "text": {
            "field": "t"
          }
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "right",
          "baseline": "bottom",
          "dx": 6,
          "dy": -24,
          "fontSize": 12,
          "fontWeight": "bold",
          "color": "#efe6d6"
        },
        "transform": [
          {
            "filter": "datum.year == 2024 && datum.vulnerable_pct == datum.max_pct && datum.n_at_max == 1"
          },
          {
            "calculate": "'Record high'",
            "as": "t"
          }
        ],
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "title": null,
            "scale": {
              "domain": [
                2008,
                2025
              ]
            },
            "axis": {
              "values": [
                2009,
                2015,
                2021,
                2024
              ],
              "format": "d",
              "grid": false,
              "labelFontSize": 12
            }
          },
          "y": {
            "field": "vulnerable_pct",
            "type": "quantitative",
            "title": "% vulnerable",
            "scale": {
              "domain": [
                5,
                12
              ],
              "zero": false
            },
            "axis": {
              "values": [
                6,
                8,
                10,
                12
              ],
              "labelExpr": "datum.value + '%'",
              "tickCount": 4
            }
          },
          "text": {
            "field": "t"
          }
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "top",
          "dx": -8,
          "dy": 10,
          "fontSize": 12,
          "color": "#efe6d6"
        },
        "transform": [
          {
            "filter": "(datum.domain == 'Emotional maturity' || datum.domain == 'Language and thinking') && datum.vulnerable_pct == datum.min_pct"
          },
          {
            "calculate": "'Low point ' + format(datum.vulnerable_pct, '.1f') + '% (' + datum.year + ')'",
            "as": "t"
          }
        ],
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "title": null,
            "scale": {
              "domain": [
                2008,
                2025
              ]
            },
            "axis": {
              "values": [
                2009,
                2015,
                2021,
                2024
              ],
              "format": "d",
              "grid": false,
              "labelFontSize": 12
            }
          },
          "y": {
            "field": "vulnerable_pct",
            "type": "quantitative",
            "title": "% vulnerable",
            "scale": {
              "domain": [
                5,
                12
              ],
              "zero": false
            },
            "axis": {
              "values": [
                6,
                8,
                10,
                12
              ],
              "labelExpr": "datum.value + '%'",
              "tickCount": 4
            }
          },
          "text": {
            "field": "t"
          }
        }
      }
    ]
  },
  "resolve": {
    "axis": {
      "x": "independent"
    }
  },
  "config": {
    "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#b3bcc5",
      "titleColor": "#b3bcc5",
      "gridColor": "#243343",
      "domainColor": "#4b5a69",
      "tickColor": "#4b5a69",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "labelFontWeight": 500
    },
    "legend": {
      "labelColor": "#b3bcc5",
      "titleColor": "#efe6d6",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "bold",
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleLimit": 0
    },
    "title": {
      "anchor": "start",
      "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "fontSize": 16,
      "fontWeight": "bold",
      "color": "#efe6d6",
      "subtitleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "subtitleColor": "#b3bcc5",
      "subtitleFontSize": 12,
      "subtitlePadding": 4,
      "offset": 12
    },
    "header": {
      "labelFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "titleFont": "\"Source Sans 3\", \"Segoe UI\", sans-serif"
    },
    "text": {
      "font": "\"Source Sans 3\", \"Segoe UI\", sans-serif",
      "fontWeight": 500
    }
  }
}
