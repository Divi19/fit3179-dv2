{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Teenagers sleep worse, not just less",
    "subtitle": "Quality of sleep on the night before the interview, 2023 · % of children with a known rating"
  },
  "width": "container",
  "height": 250,
  "data": {
    "url": "data/nnpas_sleep_quality.csv",
    "format": {
      "type": "csv",
      "parse": {
        "age_order": "number",
        "rating_order": "number",
        "pct_raw": "number",
        "pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.rating == 'Good' ? datum.pct : 0",
      "as": "g"
    },
    {
      "calculate": "datum.rating == 'Fair' ? datum.pct : 0",
      "as": "f"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "g",
          "as": "good"
        },
        {
          "op": "sum",
          "field": "f",
          "as": "fair"
        }
      ],
      "groupby": [
        "age_group"
      ]
    },
    {
      "calculate": "datum.rating == 'Very good' ? datum.good : datum.rating == 'Good' ? 0 : datum.rating == 'Fair' ? -datum.pct : -datum.fair - datum.pct",
      "as": "x0"
    },
    {
      "calculate": "datum.rating == 'Very good' ? datum.good + datum.pct : datum.rating == 'Good' ? datum.pct : datum.rating == 'Fair' ? 0 : -datum.fair",
      "as": "x1"
    },
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "mid"
    }
  ],
  "encoding": {
    "y": {
      "field": "age_group",
      "type": "ordinal",
      "title": null,
      "sort": [
        "2–5",
        "5–8",
        "9–11",
        "12–14",
        "15–17"
      ],
      "scale": {
        "paddingOuter": 0.5
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontWeight": "bold",
        "labelColor": "#1d2a35",
        "labelFontSize": 12,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.62
        }
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "title": "% of children with a known rating",
          "scale": {
            "domain": [
              -30,
              100
            ]
          },
          "axis": {
            "values": [
              -20,
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "labelExpr": "abs(datum.value) + '%'"
          }
        },
        "x2": {
          "field": "x1"
        },
        "color": {
          "field": "rating",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Poor / very poor",
              "Fair",
              "Good",
              "Very good"
            ],
            "range": [
              "#b3561a",
              "#eda96a",
              "#7fbcd0",
              "#16739a"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolStrokeWidth": 0
          }
        },
        "tooltip": [
          {
            "field": "age_group",
            "title": "Age"
          },
          {
            "field": "rating",
            "title": "Sleep quality"
          },
          {
            "field": "pct",
            "title": "% of known ratings",
            "format": ".1f"
          },
          {
            "field": "pct_raw",
            "title": "% published (incl. not known)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rating == 'Very good'"
        },
        {
          "calculate": "format(datum.pct, '.0f') + '%'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "mid",
          "type": "quantitative",
          "title": "% of children with a known rating",
          "scale": {
            "domain": [
              -30,
              100
            ]
          },
          "axis": {
            "values": [
              -20,
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "labelExpr": "abs(datum.value) + '%'"
          }
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#1d2a35",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "title": "% of children with a known rating",
          "scale": {
            "domain": [
              -30,
              100
            ]
          },
          "axis": {
            "values": [
              -20,
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "labelExpr": "abs(datum.value) + '%'"
          }
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": {
            "expr": "height"
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": -1.5,
            "t": "← Fair or poor"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#b3561a"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "title": "% of children with a known rating",
          "scale": {
            "domain": [
              -30,
              100
            ]
          },
          "axis": {
            "values": [
              -20,
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "labelExpr": "abs(datum.value) + '%'"
          }
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1.5,
            "t": "Good or very good →"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#16739a"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "title": "% of children with a known rating",
          "scale": {
            "domain": [
              -30,
              100
            ]
          },
          "axis": {
            "values": [
              -20,
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "labelExpr": "abs(datum.value) + '%'"
          }
        },
        "y": {
          "value": 0
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rating == 'Very good'"
        },
        {
          "window": [
            {
              "op": "first_value",
              "field": "pct",
              "as": "first"
            },
            {
              "op": "last_value",
              "field": "pct",
              "as": "last"
            },
            {
              "op": "last_value",
              "field": "x1",
              "as": "last_end"
            }
          ],
          "sort": [
            {
              "field": "age_order"
            }
          ],
          "frame": [
            null,
            null
          ]
        },
        {
          "filter": "datum.age_order == 4"
        },
        {
          "calculate": "\"'Very good' sleep halves: \" + format(datum.first, '.0f') + '% → ' + format(datum.last, '.0f') + '%'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#16739a",
        "dy": {
          "expr": "height / 13"
        }
      },
      "encoding": {
        "x": {
          "datum": 100,
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ],
  "config": {
    "font": "Atkinson Hyperlegible",
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b6670",
      "titleColor": "#5b6670",
      "gridColor": "#e7e9e8",
      "domainColor": "#b8bec2",
      "tickColor": "#b8bec2",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "legend": {
      "labelColor": "#5b6670",
      "titleColor": "#1d2a35",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "bold",
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "title": {
      "anchor": "start",
      "font": "Atkinson Hyperlegible",
      "fontSize": 15,
      "fontWeight": "bold",
      "color": "#1d2a35",
      "subtitleFont": "Atkinson Hyperlegible",
      "subtitleColor": "#5b6670",
      "subtitleFontSize": 12,
      "subtitlePadding": 4,
      "offset": 12
    },
    "header": {
      "labelFont": "Atkinson Hyperlegible",
      "titleFont": "Atkinson Hyperlegible"
    },
    "text": {
      "font": "Atkinson Hyperlegible"
    }
  }
}
